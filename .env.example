# Odoo CRM backend (used for event notification signups)
ODOO_URL=https://odoo.code.pr
ODOO_DB=cpr
ODOO_USER=your@email.com
ODOO_API_KEY=your_odoo_api_key

# Random secret for signing email verification tokens (generate with: openssl rand -hex 32)
NOTIFY_SECRET=change_me_to_a_random_secret

# Cloudflare Access service token (allows code.pr Pages to reach odoo.code.pr past CF Access)
CF_ACCESS_CLIENT_ID=your_client_id.access
CF_ACCESS_CLIENT_SECRET=your_client_secret

# TikTok Lead Gen webhook secret — found in Ads Manager → Assets → Leads → Webhooks
# Leave unset to skip signature verification (not recommended in production)
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret
